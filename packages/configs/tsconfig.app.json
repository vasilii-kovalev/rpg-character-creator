{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"target": "ESNext",
		"lib": ["ESNext", "DOM"],
		"types": ["vite/client"],
		"paths": {
			"packages/*": ["../../packages/*/src/index.ts"],
			// `${configDir}` is the extending workspace, so `@/` always means that package's `src/`.
			"@/*": ["${configDir}/src/*"]
		}
	},
	// Not used on its own. Workspace `tsconfig.app.json` files extend this and set `include`.
	"files": [],
	"exclude": ["${configDir}/src/**/*.test.ts", "${configDir}/src/**/*.test.tsx"]
}
