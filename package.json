{
	"name": "rpg-character-creator",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"install:browsers": "cross-env PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium firefox",
		"dev:dashboard": "vp -C apps/dashboard dev",
		"dev:example": "vp -C apps/example dev",
		"dev:ui": "npm run storybook -w packages/ui",
		"prod:build": "vp run build-site",
		"prod:preview": "vp preview --outDir site",
		"prod:publish": "npm run prod:build && gh-pages -d site --nojekyll",
		"format:check": "vp run fmt:check",
		"format:fix": "vp run fmt:fix",
		"lint:css:check": "vp run stylelint:check",
		"lint:css:fix": "vp run stylelint:fix",
		"lint:markdown:check": "vp run markdownlint:check",
		"lint:markdown:fix": "vp run markdownlint:fix",
		"lint:spell:check": "vp run cspell:check",
		"lint:ts:check": "vp run lint:check",
		"lint:ts:fix": "vp run lint:fix",
		"check-and-fix": "vp run stylelint:fix && vp run markdownlint:fix && vp run lint:fix && vp run cspell:check && vp run fmt:fix",
		"test": "cross-env PLAYWRIGHT_BROWSERS_PATH=0 vp test",
		"test:ui": "cross-env PLAYWRIGHT_BROWSERS_PATH=0 vp test watch --ui"
	},
	"devDependencies": {
		"@types/node": "22.20.5",
		"@vitest/ui": "5.0.5",
		"cross-env": "10.1.0",
		"cspell": "10.4.0",
		"cspell-check-unused-words": "1.6.3",
		"gh-pages": "6.3.0",
		"markdownlint-cli2": "0.23.3",
		"postcss-styled-syntax": "0.7.4",
		"stylelint": "17.16.0",
		"stylelint-config-standard": "40.0.0",
		"stylelint-order": "8.1.2",
		"typescript": "7.0.2",
		"vite-plus": "1.3.0"
	},
	"overrides": {
		"make-dir": {
			"semver": "6.3.1"
		},
		"markdownlint-cli2": {
			"katex": "0.19.0",
			"markdown-it": "15.0.3",
			"smol-toml": "1.9.1"
		},
		"vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
		"vitest": "5.0.5"
	},
	"devEngines": {
		"packageManager": {
			"name": "npm",
			"version": "^12.0.0",
			"onFail": "error"
		},
		"runtime": {
			"name": "node",
			"version": "^22.22.2 || ^24.15.0 || >=26.0.0",
			"onFail": "error"
		}
	}
}
